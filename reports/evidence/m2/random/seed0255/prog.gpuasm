.reg vgpr_count=4 sgpr_count=64
.kern rnd args=()
rnd:
  S_MOV   s29, 0
  S_XOR   s19, s2, s12
  S_GETID s17, WG_X
  S_SUB   s10, s19, s15
  NOP
  NOP
  S_GETID s10, WG_X
  S_SHL   s11, s15, s13
  NOP
  S_SHL   s20, s14, s14
  S_MOV   s30, 1
LOOP:
  S_ADD   s21, s21, 1
  S_SUB   s30, s30, 1
  S_CMP_EQ s30, s29
  S_BRA_COND NZ, LOOP
  RET_KERNEL_WF
