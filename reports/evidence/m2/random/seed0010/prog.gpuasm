.reg vgpr_count=4 sgpr_count=64
.kern rnd args=()
rnd:
  S_MOV   s29, 0
  S_SHR   s19, s1, 31
  NOP
  S_SHL   s3, s8, 26
  NOP
  S_SAR   s9, s15, 19
  S_CMP_LT s15, s8
  S_BRA_COND LT_U, SK0
  NOP
SK0:
  S_NOT   s8, s5
  NOP
  S_MOV   s30, 2
LOOP:
  S_ADD   s21, s21, 1
  S_SUB   s30, s30, 1
  S_CMP_EQ s30, s29
  S_BRA_COND NZ, LOOP
  RET_KERNEL_WF
