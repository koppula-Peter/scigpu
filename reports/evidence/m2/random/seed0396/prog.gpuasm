.reg vgpr_count=4 sgpr_count=64
.kern rnd args=()
rnd:
  S_MOV   s29, 0
  S_AND   s9, s18, s5
  S_SAR   s12, s17, 25
  NOP
  S_MOV   s14, 0
  S_CMP_LT s17, s9
  S_BRA_COND Z, SK0
  NOP
  NOP
SK0:
  NOP
  S_OR    s20, s2, s9
  S_ADD   s10, s17, 1
  S_ADD   s9, s7, s12
  S_MOV   s30, 1
LOOP:
  S_ADD   s21, s21, 1
  S_SUB   s30, s30, 1
  S_CMP_EQ s30, s29
  S_BRA_COND NZ, LOOP
  RET_KERNEL_WF
