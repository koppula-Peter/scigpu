.reg vgpr_count=4 sgpr_count=64
.kern rnd args=()
rnd:
  S_MOV   s29, 0
  S_AND   s17, s11, s19
  S_GETID s19, WG_X
  S_GETID s4, WG_X
  S_SAR   s19, s10, s9
  S_AND   s20, s4, s14
  S_XOR   s8, s7, s20
  NOP
  S_MOV   s30, 4
LOOP:
  S_ADD   s21, s21, 1
  S_SUB   s30, s30, 1
  S_CMP_EQ s30, s29
  S_BRA_COND NZ, LOOP
  RET_KERNEL_WF
