.reg vgpr_count=4 sgpr_count=64
.kern rnd args=()
rnd:
  S_MOV   s29, 0
  S_XOR   s7, s3, s19
  S_OR    s17, s13, s6
  S_SAR   s19, s3, 2
  S_NOT   s4, s13
  S_SHR   s1, s20, 2
  S_SUB   s11, s5, s6
  S_NOT   s4, s8
  S_CMP_GT s17, s8
  S_BRA_COND SCC, SK0
  NOP
  NOP
SK0:
  S_MOV   s30, 3
LOOP:
  S_ADD   s21, s21, 1
  S_SUB   s30, s30, 1
  S_CMP_EQ s30, s29
  S_BRA_COND NZ, LOOP
  RET_KERNEL_WF
