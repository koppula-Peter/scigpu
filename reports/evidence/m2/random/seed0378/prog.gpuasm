.reg vgpr_count=4 sgpr_count=64
.kern rnd args=()
rnd:
  S_MOV   s29, 0
  S_MUL   s13, s15, s5
  S_SHR   s1, s5, 6
  S_NOT   s16, s1
  NOP
  NOP
  S_CMP_GT s8, s19
  S_BRA_COND GE_U, SK0
  NOP
  NOP
  NOP
SK0:
  S_CMP_EQ s4, s10
  S_BRA_COND Z, SK1
  NOP
  NOP
  NOP
SK1:
  S_MOV   s30, 4
LOOP:
  S_ADD   s21, s21, 1
  S_SUB   s30, s30, 1
  S_CMP_EQ s30, s29
  S_BRA_COND NZ, LOOP
  RET_KERNEL_WF
