.reg vgpr_count=4 sgpr_count=64
.kern rnd args=()
rnd:
  S_MOV   s29, 0
  NOP
  NOP
  S_SAR   s17, s15, 17
  NOP
  NOP
  NOP
  S_ADD   s14, s16, s19
  S_NOT   s15, s19
  S_CMP_EQ s1, s12
  S_BRA_COND GE_S, SK0
  NOP
  NOP
SK0:
  S_AND   s8, s15, s16
  S_NOT   s2, s3
  S_NOT   s5, s19
  S_SHR   s2, s8, 16
  NOP
  S_MOV   s30, 3
LOOP:
  S_ADD   s21, s21, 1
  S_SUB   s30, s30, 1
  S_CMP_EQ s30, s29
  S_BRA_COND NZ, LOOP
  RET_KERNEL_WF
