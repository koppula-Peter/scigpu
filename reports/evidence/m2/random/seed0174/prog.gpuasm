.reg vgpr_count=4 sgpr_count=64
.kern rnd args=()
rnd:
  S_MOV   s29, 0
  S_SHL   s1, s16, 14
  NOP
  S_CMP_GT s19, s3
  S_BRA_COND GE_S, SK0
  NOP
  NOP
  NOP
SK0:
  S_XOR   s11, s15, s1
  S_GETID s4, WG_X
  S_AND   s16, s9, s2
  S_MOV   s30, 3
LOOP:
  S_ADD   s21, s21, 1
  S_SUB   s30, s30, 1
  S_CMP_EQ s30, s29
  S_BRA_COND NZ, LOOP
  RET_KERNEL_WF
