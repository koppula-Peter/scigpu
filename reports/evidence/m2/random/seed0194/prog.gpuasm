.reg vgpr_count=4 sgpr_count=64
.kern rnd args=()
rnd:
  S_MOV   s29, 0
  S_NOT   s12, s13
  S_GETID s14, WG_X
  S_SAR   s14, s12, 6
  S_CMP_EQ s4, s19
  S_BRA_COND NSCC, SK0
  NOP
  NOP
  NOP
SK0:
  S_NOT   s5, s12
  S_OR    s3, s7, s7
  S_CMP_LT s15, s8
  S_BRA_COND NZ, SK1
  NOP
  NOP
  NOP
SK1:
  NOP
  S_SAR   s9, s14, s16
  S_NOT   s6, s14
  S_MOV   s30, 4
LOOP:
  S_ADD   s21, s21, 1
  S_SUB   s30, s30, 1
  S_CMP_EQ s30, s29
  S_BRA_COND NZ, LOOP
  RET_KERNEL_WF
