.reg vgpr_count=4 sgpr_count=64
.kern rnd args=()
rnd:
  S_MOV   s29, 0
  S_MOV   s10, 0
  S_CMP_LT s6, s3
  S_BRA_COND LT_S, SK0
  NOP
SK0:
  NOP
  S_SHL   s20, s14, 21
  S_CMP_EQ s7, s1
  S_BRA_COND LT_S, SK1
  NOP
SK1:
  S_SHL   s14, s19, 0
  S_SHR   s13, s11, s19
  S_NOT   s9, s12
  S_ADD   s4, s20, s8
  NOP
  S_SHR   s5, s5, 29
  S_ADD   s1, s11, s16
  S_GETID s18, WG_X
  S_NOT   s10, s17
  S_MOV   s30, 1
LOOP:
  S_ADD   s21, s21, 1
  S_SUB   s30, s30, 1
  S_CMP_EQ s30, s29
  S_BRA_COND NZ, LOOP
  RET_KERNEL_WF
