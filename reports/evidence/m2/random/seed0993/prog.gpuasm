.reg vgpr_count=4 sgpr_count=64
.kern rnd args=()
rnd:
  S_MOV   s29, 0
  NOP
  S_NOT   s8, s12
  S_AND   s20, s14, s8
  S_SUB   s2, s2, s2
  S_SAR   s13, s19, s1
  S_NOT   s19, s20
  S_CMP_GT s7, s2
  S_BRA_COND LT_S, SK0
  NOP
  NOP
  NOP
SK0:
  S_NOT   s13, s1
  S_GETID s12, WG_X
  S_MOV   s30, 2
LOOP:
  S_ADD   s21, s21, 1
  S_SUB   s30, s30, 1
  S_CMP_EQ s30, s29
  S_BRA_COND NZ, LOOP
  RET_KERNEL_WF
