  S_CMP_LT s6, s20
  S_BRA_COND NZ, SK0
  NOP
SK0:
  S_MOV   s12, 1630805740
  S_GETID s3, WG_X
  NOP
  S_OR    s10, s1, s20
  S_MOV   s13, 1115700674
  S_ADD   s5, s19, s15
  S_MOV   s30, 1
LOOP:
