.reg vgpr_count=4 sgpr_count=64
.kern rnd args=()
rnd:
  S_MOV   s29, 0
  NOP
  NOP
  S_CMP_LT s15, s9
  S_BRA_COND GE_U, SK0
  NOP
SK0:
  S_AND   s4, s10, s13
  S_CMP_GT s14, s8
  S_BRA_COND GE_U, SK1
  NOP
  NOP
SK1:
  S_CMP_LT s5, s5
  S_BRA_COND GE_U, SK2
  NOP
SK2:
  NOP
  S_NOT   s18, s11
  S_MOV   s30, 2
LOOP:
  S_ADD   s21, s21, 1
  S_SUB   s30, s30, 1
  S_CMP_EQ s30, s29
  S_BRA_COND NZ, LOOP
  RET_KERNEL_WF
