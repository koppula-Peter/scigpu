.reg vgpr_count=4 sgpr_count=64
.kern rnd args=()
rnd:
  S_MOV   s29, 0
  S_MOV   s9, 4294967295
  S_SHR   s15, s10, s3
  S_CMP_GT s9, s7
  S_BRA_COND LT_S, SK0
  NOP
SK0:
  S_SUB   s15, s16, s7
  S_ADD   s4, s12, s20
  S_SAR   s7, s15, s4
  S_CMP_LT s1, s15
  S_BRA_COND SCC, SK1
  NOP
SK1:
  S_CMP_EQ s15, s16
  S_BRA_COND SCC, SK2
  NOP
SK2:
  S_MOV   s30, 1
LOOP:
  S_ADD   s21, s21, 1
  S_SUB   s30, s30, 1
  S_CMP_EQ s30, s29
  S_BRA_COND NZ, LOOP
  RET_KERNEL_WF
