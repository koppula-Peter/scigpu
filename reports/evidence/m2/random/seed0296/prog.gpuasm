.reg vgpr_count=4 sgpr_count=64
.kern rnd args=()
rnd:
  S_MOV   s29, 0
  NOP
  S_CMP_EQ s14, s6
  S_BRA_COND SCC, SK0
  NOP
  NOP
SK0:
  S_CMP_LT s8, s1
  S_BRA_COND GE_S, SK1
  NOP
SK1:
  S_GETID s20, WG_X
  S_AND   s20, s15, s14
  S_GETID s18, WG_X
  S_OR    s10, s3, s19
  NOP
  S_CMP_GT s15, s18
  S_BRA_COND GE_S, SK2
  NOP
  NOP
SK2:
  S_XOR   s4, s6, s11
  S_MOV   s30, 1
LOOP:
  S_ADD   s21, s21, 1
  S_SUB   s30, s30, 1
  S_CMP_EQ s30, s29
  S_BRA_COND NZ, LOOP
  RET_KERNEL_WF
