.reg vgpr_count=4 sgpr_count=64
.kern rnd args=()
rnd:
  S_MOV   s29, 0
  S_AND   s11, s2, s1
  S_AND   s19, s8, s8
  S_SUB   s1, s13, 0
  S_CMP_EQ s11, s17
  S_BRA_COND LT_U, SK0
  NOP
  NOP
  NOP
SK0:
  S_SAR   s9, s19, s1
  S_SHR   s12, s8, 27
  S_AND   s13, s18, s6
  NOP
  NOP
  S_SAR   s20, s20, s11
