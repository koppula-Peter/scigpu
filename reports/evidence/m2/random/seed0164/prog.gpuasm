.reg vgpr_count=4 sgpr_count=64
.kern rnd args=()
rnd:
  S_MOV   s29, 0
  S_GETID s9, WG_X
  S_NOT   s4, s3
  S_SUB   s19, s7, 0
  NOP
  S_MOV   s3, 0
  S_CMP_EQ s18, s17
  S_BRA_COND GE_U, SK0
  NOP
SK0:
  S_MOV   s7, 0
  S_CMP_EQ s8, s13
  S_BRA_COND Z, SK1
  NOP
  NOP
  NOP
SK1:
  S_SUB   s2, s15, 1
  S_NOT   s4, s13
  NOP
  S_SHR   s11, s9, s13
  S_MOV   s30, 2
LOOP:
  S_ADD   s21, s21, 1
  S_SUB   s30, s30, 1
  S_CMP_EQ s30, s29
  S_BRA_COND NZ, LOOP
  RET_KERNEL_WF
